# Application environment
APP_ENV=development
LOG_LEVEL=INFO

# Recovery execution safety
RECOVERY_EXECUTION_MODE=dry_run
ALLOW_LIVE_RECOVERY=false

# Configuration file locations
RECOVERY_CONFIG=config.yaml
RECOVERY_POLICIES=recovery_policies.yaml
SERVICE_DEPENDENCIES=service_dependencies.yaml

# Monitoring integration
MONITORING_BASE_URL=http://localhost:9090
MONITORING_API_TOKEN=

# Optional incident notification integration
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Optional external service credentials
SERVICE_API_URL=
SERVICE_API_TOKEN=

# Never commit real credentials to version control.
# Supply production secrets through a secrets manager or secure
# deployment environment variables.